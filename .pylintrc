[MASTER]
# Load docparams plugin for parameter documentation enforcement
load-plugins = pylint.extensions.docparams

# Number of jobs for parallel processing (0 = auto)
jobs = 0

# Allow these modules to be used without being imported explicitly
extension-pkg-allow-list = cv2, numpy, tensorrt

[MESSAGES CONTROL]
# C0114 = missing-module-docstring
# C0115 = missing-class-docstring
# C0116 = missing-function-docstring (allowed on private/protected)
# W0212 = protected-access (allowed in tests)
# R0903 = too-few-public-methods (ABCs often have few)
disable =
    C0114,
    C0115,
    C0116,
    W0212,
    R0903

[FORMAT]
max-line-length = 100
indent-string = "    "

[DESIGN]
# Maximum number of arguments for function / method
max-args = 8

# Maximum number of attributes for a class
max-attributes = 12

# Minimum number of public methods for a class
min-public-methods = 1

# Maximum number of return statements
max-returns = 6

# Maximum McCabe complexity
max-complexity = 12

# Maximum number of nested blocks
max-nested-blocks = 4

[SIMILARITIES]
# Minimum number of lines that a match must span to be considered a duplicate
min-similarity-lines = 6
ignore-imports = yes
ignore-docstrings = yes

[TYPECHECK]
# Don't raise errors for dynamically-set attributes on these classes
ignored-classes = redis.client.Redis, aioredis.client.Redis

[LOGGING]
# Logging format: use % formatting (structlog handles the rest)
logging-format-style = new

[REPORTS]
# Output format: text for CI, json for tooling integration
output-format = text

# Minimum score — CI fails below this
fail-under = 8.5
