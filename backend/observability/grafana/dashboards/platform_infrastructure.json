      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (state) (pg_stat_activity_count{datname=\"postgres\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "title": "Postgres Connections by State",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "id": 9,
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"postgres\"}[5m]))",
          "legendFormat": "commit",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"postgres\"}[5m]))",
          "legendFormat": "rollback",
          "refId": "B"
        }
      ],
      "title": "Postgres Transaction Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
