      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (camera_id) (rate(frames_received_total[1m]))",
          "legendFormat": "{{camera_id}}",
          "refId": "A"
        }
      ],
      "title": "Sampled FPS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (camera_id) (rate(frames_dropped_total[1m]))",
          "legendFormat": "{{camera_id}}",
          "refId": "A"
        }
      ],
      "title": "Frame Drops",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
