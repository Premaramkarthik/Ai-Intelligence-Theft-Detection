global:
  scrape_interval: 5s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: rtsp_camera_backend
    metrics_path: /metrics
    static_configs:
      - targets:
          - __PROMETHEUS_SCRAPE_TARGET__
  - job_name: mediamtx
    metrics_path: /metrics
    basic_auth:
      username: __MEDIAMTX_METRICS_USERNAME__
      password: __MEDIAMTX_METRICS_PASSWORD__
    static_configs:
      - targets:
          - mediamtx:9998
  - job_name: milvus
    metrics_path: /metrics
    static_configs:
      - targets:
          - milvus:9091
  # Optional inference and GPU exporters are intentionally omitted from the
  # default local stack. Add them back when those services are actually running.
  - job_name: kafka_jmx
    metrics_path: /metrics
    static_configs:
      - targets:
          - kafka:7071
  - job_name: node
    metrics_path: /metrics
    static_configs:
      - targets:
          - node-exporter:9100
  - job_name: postgres_exporter
    metrics_path: /metrics
    static_configs:
      - targets:
          - postgres-exporter:9187
  - job_name: loki
    metrics_path: /metrics
    static_configs:
      - targets:
          - loki:3100
  - job_name: alloy
    metrics_path: /metrics
    static_configs:
      - targets:
          - alloy:12345
