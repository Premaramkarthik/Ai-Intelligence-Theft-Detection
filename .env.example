# =========================================================
# Pipeline OpenCV — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# =========================================================

# ---------------------------------------------------------
# Redis
# ---------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=karthikS9
# Optional: Redis DB index (0-15)
REDIS_DB=0

# ---------------------------------------------------------
# PostgreSQL (Persistence Layer)
# ---------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pipeline_events
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=postgres
# Max pool connections for asyncpg
POSTGRES_POOL_SIZE=10

PGADMIN_EMAIL=premaramkarthik99@gmail.com
PGADMIN_PASSWORD=admin

# ---------------------------------------------------------
# Telegram Bot
# ---------------------------------------------------------
# Get from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=8351386436:AAFUV5TB9J86LIwcZzzS26m-3Ib7n-mGxco
# Comma-separated admin chat IDs (use @userinfobot to find yours)
TELEGRAM_ADMIN_CHAT_IDS=123456789,987654321

# ---------------------------------------------------------
# JWT (Signaling Service Auth)
# ---------------------------------------------------------
JWT_SECRET=a9F3kLm2Qx7ZpT8vBn4RjY6wHs1DcE5u
JWT_ALGORITHM=HS256
# Token expiry in minutes
JWT_EXPIRE_MINUTES=60

# ---------------------------------------------------------
# Signaling Service
# ---------------------------------------------------------
SIGNALING_HOST=0.0.0.0
SIGNALING_PORT=9001
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:9000,http://localhost:3000

# ---------------------------------------------------------
# MediaBridge / Video Input
# ---------------------------------------------------------
# Comma-separated list of sources: numeric (webcam) or RTSP URL
# Example: CAMERA_SOURCES=0,rtsp://admin:pass@192.168.1.101:554/stream
CAMERA_SOURCES=0
# Default input type: rtsp | webcam
DEFAULT_INPUT_TYPE=rtsp

# ---------------------------------------------------------
# Camera Source Config (repeat per camera, or use Redis HASH)
# Example for cam01:
# ---------------------------------------------------------
CAM01_INPUT_TYPE=rtsp
CAM01_RTSP_URL=rtsp://admin:pass@192.168.1.101:554/stream
CAM01_ROI=0,0,1280,720

CAM02_INPUT_TYPE=webcam
CAM02_DEVICE_ID=0

# ---------------------------------------------------------
# Model Quantization Tool (offline, not pipeline)
# ---------------------------------------------------------
# Which model the pipeline loads at runtime:
# Options: efficient_x3d | cnn_transformer | cnn_lstm | lightly_distill | movinet | vae
MODEL_NAME=cnn_transformer
# Path to Transformer or LSTM model:
# Transformer: models/cnn_transformers/cnn_Transformer.pth
# LSTM: models/model_cnn_lstm/best_model.pth
MODEL_ENGINE_PATH=models/cnn_transformers/cnn_Transformer.pth
MODEL_BACKEND=tensorrt   # tensorrt | openvino
# Temporal window depth (N frames per clip)
TEMPORAL_WINDOW=16
# Detection confidence threshold (overridable per camera via Redis)
DEFAULT_CONFIDENCE_THRESHOLD=0.7
# Frame staleness hard limit (ms) — drop batch if exceeded
STALENESS_LIMIT_MS=150
# Heartbeat interval (ms)
HEARTBEAT_INTERVAL_MS=500
# CPU cores to pin inference process to (e.g., "4,5,6,7")
CPU_AFFINITY_CORES=4,5,6,7
# Fraction of GPU memory to pre-allocate (0.0-1.0)
GPU_MEM_FRACTION=0.8

# ---------------------------------------------------------
# Detection Pipeline
# ---------------------------------------------------------
# --- Person Detection (YOLOv8n-seg) ---
PERSON_DETECTOR_ENGINE=models/yolov8n-seg/quantized/yolov8n-seg.engine
PERSON_CONF_THRESHOLD=0.5
PERSON_INPUT_SIZE=640

# --- Background Blur ---
BLUR_KERNEL_SIZE=51   # must be odd

# --- ByteTrack ---
TRACK_LOST_TIMEOUT_S=2
BYTETRACK_MATCH_THRESH=0.8

# --- Item Detection ---
ITEM_DETECTOR_ENGINE=models/yolov8n/quantized/yolov8n.engine
ITEM_DETECT_EVERY_N_FRAMES=5   # run item detection every 5th frame
# Item classes to watch (comma-separated COCO names or custom)
ITEM_WATCH_CLASSES=bottle,backpack,handbag

# --- Item Interaction Rules ---
ITEM_IOU_THRESHOLD=0.15
HAND_DIST_PX=80
MIN_DISPLACEMENT_PX=30
INTERACTION_FRAMES=5   # consecutive frames condition must hold

# --- Triggered Video Classification ---
CLASSIFICATION_FRAMES=16         # temporal window length
CLASSIFICATION_BATCH_MAX=4       # max windows batched per GPU call
CLASSIFICATION_BATCH_WAIT_MS=50  # max wait before flush

# ---------------------------------------------------------
# Alert Dispatcher
# ---------------------------------------------------------
# Alert cooldown per camera (seconds) — prevents duplicate alerts
ALERT_COOLDOWN_SECONDS=30
# Confidence threshold to trigger Telegram alert
ALERT_CONFIDENCE_THRESHOLD=0.85
# MQTT broker for external alerts
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password

# ---------------------------------------------------------
# Persistence Worker
# ---------------------------------------------------------
# Window for batch aggregation before bulk DB insert (ms)
PERSISTENCE_BATCH_WINDOW_MS=500
# Local directory to store evidence snapshots (NVMe recommended)
EVIDENCE_STORAGE_PATH=/data/evidence
# Retention period in days (files older than this are pruned daily)
EVIDENCE_RETENTION_DAYS=30

# ---------------------------------------------------------
# Logging
# ---------------------------------------------------------
LOG_LEVEL=INFO
# Max log file size in bytes (500MB)
LOG_MAX_BYTES=524288000
LOG_BACKUP_COUNT=5
LOG_FILE_PATH=/var/log/pipeline/pipeline.log
